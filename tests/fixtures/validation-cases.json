      "input": { "password": "Aa1bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "password_confirm": "Aa1bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" },
      "expectedBytes": { "password": 73, "password_confirm": 73 },
      "expectedErrors": {
        "password": ["La contraseña debe tener entre 8 y 72 caracteres."],
        "password_confirm": ["La contraseña debe tener entre 8 y 72 caracteres."]
      }
    },
    {
      "id": "password-accents-7-chars-12-bytes",
      "field": "password",
      "rules": ["bytes", "composition"],
      "valid": true,
      "input": { "password": "áéíóúA1", "password_confirm": "áéíóúA1" },
      "expectedBytes": { "password": 12, "password_confirm": 12 },
      "normalized": { "password": "áéíóúA1", "password_confirm": "áéíóúA1" },
      "expectedErrors": {},
      "note": "Seven characters but 12 UTF-8 bytes; the byte-based rule accepts what a naive character-count rule would reject."
    },
    {
      "id": "password-accents-72-bytes",
      "field": "password",
      "rules": ["bytes", "composition"],
      "valid": true,
      "input": { "password": "ññññññññññññññññññññññññññññññññññña1", "password_confirm": "ññññññññññññññññññññññññññññññññññña1" },
      "expectedBytes": { "password": 72, "password_confirm": 72 },
      "normalized": { "password": "ññññññññññññññññññññññññññññññññññña1", "password_confirm": "ññññññññññññññññññññññññññññññññññña1" },
      "expectedErrors": {},
      "note": "Thirty-five U+00F1 characters (70 bytes) plus 'a1' (2 bytes): exactly 72 UTF-8 bytes with 37 characters."
    },
    {
      "id": "password-accents-73-bytes",
      "field": "password",
      "rules": ["bytes"],
      "valid": false,
      "input": { "password": "ññññññññññññññññññññññññññññññññññña1x", "password_confirm": "ññññññññññññññññññññññññññññññññññña1x" },
      "expectedBytes": { "password": 73, "password_confirm": 73 },
      "expectedErrors": {
        "password": ["La contraseña debe tener entre 8 y 72 caracteres."],
        "password_confirm": ["La contraseña debe tener entre 8 y 72 caracteres."]
      },
      "note": "Accented characters counted as UTF-8 bytes push the value one byte over the 72-byte bound; composition still passes, so the only message is the length one."
    },
    {
      "id": "password-accents-7-bytes",
      "field": "password",
      "rules": ["bytes", "composition"],
      "valid": false,
      "input": { "password": "áéí1", "password_confirm": "áéí1" },
      "expectedBytes": { "password": 7, "password_confirm": 7 },
      "expectedErrors": {
        "password": [
          "La contraseña debe tener entre 8 y 72 caracteres.",
          "La contraseña debe incluir al menos una letra y un número."
        ],
        "password_confirm": [
          "La contraseña debe tener entre 8 y 72 caracteres.",
          "La contraseña debe incluir al menos una letra y un número."
        ]
      },
      "note": "Four accented/digit characters = 7 UTF-8 bytes (under the byte bound) and no ASCII letter; multi-failure order pin: bytes before composition. Both fields carry the same invalid value, so both report the same two messages."
    },
    {
      "id": "password-letters-only",
      "field": "password",
      "rules": ["composition"],
      "valid": false,
      "input": { "password": "abcdefghij", "password_confirm": "abcdefghij" },
      "expectedBytes": { "password": 10, "password_confirm": 10 },
      "expectedErrors": {
        "password": ["La contraseña debe incluir al menos una letra y un número."],
        "password_confirm": ["La contraseña debe incluir al menos una letra y un número."]
      }
    },
    {
      "id": "password-digits-only",
      "field": "password",
      "rules": ["composition"],
      "valid": false,
      "input": { "password": "12345678", "password_confirm": "12345678" },
      "expectedBytes": { "password": 8, "password_confirm": 8 },
      "expectedErrors": {
        "password": ["La contraseña debe incluir al menos una letra y un número."],
        "password_confirm": ["La contraseña debe incluir al menos una letra y un número."]
      }
    },
