{
  "_meta": {
    "spec": "001-create-account",
    "purpose": "Shared validation case corpus for client (RF-5) and server (RF-6) rule and message parity (plan decision 6).",
    "messageSource": "plan.md, section 'Validation and messages'; the Spanish message strings below are exact approved copy and must not be reworded.",
    "classification": {
      "valid": "positive case: a validator must report no errors for the fields under test",
      "invalid": "negative case: a validator must report exactly expectedErrors for the fields under test, one message per failing rule, in the recorded order"
    },
    "scope": "Format and composition rules only. Uniqueness (RF-6/RFC-7 duplicates) is a Layer 2 server concern and is intentionally not covered here.",
    "baseValidRecord": {
      "name": "Ana",
      "lastname": "Pérez",
      "email": "ana.perez@example.com",
      "phone": "88887777",
      "id": "8-1234-5678",
      "password": "Contrasena1",
      "password_confirm": "Contrasena1",
      "terms": true
    },
    "harnessNote": "Each case input is merged over baseValidRecord; only the fields present in a case's input are under test, and expectedErrors covers only those fields.",
    "ruleOrder": "One message per failing rule, grouped by field, in the fixed order from plan.md: required/empty, length/bytes, character composition/content, format, confirmation.",
    "fieldRuleOrder": {
      "name": ["required", "length", "composition", "content"],
      "lastname": ["required", "length", "composition", "content"],
      "email": ["required", "length", "format"],
      "phone": ["required", "digits"],
      "id": ["required", "length", "composition"],
      "password": ["required", "bytes", "composition"],
      "password_confirm": ["required", "confirmation"],
      "terms": ["required"]
    },
    "ruleNotes": {
      "phone.digits": "Single approved rule: after removing an optional single leading '+', spaces, hyphens, and parentheses, the remainder must be 7-20 ASCII digits. Disallowed characters (for example a non-leading '+') and out-of-range counts share the single approved phone message.",
      "id.composition": "Single approved rule covering 'ASCII letters, digits, and hyphens only' AND 'at least one alphanumeric character'; both share the one approved id composition message in the plan message table, so hyphen-only values expect that message.",
      "email.format": "Covers the shared ASCII structural pattern; the server additionally applies FILTER_VALIDATE_EMAIL. Cases marked serverOnly are asserted on the server only.",
      "email.lengthOrder": "Per plan.md's fixed rule order, the 150-character length check precedes the format check for multi-failure values.",
      "password.bytes": "The user-facing message says 'caracteres' while the rule enforces UTF-8 bytes (plan decision 10)."
    },
    "byteLengths": "Password-bearing cases record the expected UTF-8 byte length per value in expectedBytes; both validators must enforce these byte counts.",
    "normalization": {
      "name": "trim surrounding whitespace; length counted in code points after trim",
      "lastname": "trim surrounding whitespace; length counted in code points after trim",
      "email": "trim surrounding whitespace and lowercase",
      "phone": "remove optional single leading '+', spaces, hyphens, and parentheses; store ASCII digits only",
      "id": "trim surrounding whitespace; store as typed (case preserved)",
      "password": "never trimmed; validated and stored as typed",
      "password_confirm": "never trimmed"
    },
    "serverOnly": "When true, the shared structural email pattern may accept the value while PHP FILTER_VALIDATE_EMAIL rejects it; client-side assertions skip the case and only the server outcome (expectedErrors) is asserted. Such cases are not dropped from the corpus."
  },
